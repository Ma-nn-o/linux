#!/usr/bin/env bash
# theme — switch the terminal's 16-color palette live and persist the choice.
#
#   theme            list themes (current one marked)
#   theme <name>     apply + persist (new shells pick it up via ~/.zshrc)
#
# Works in any terminal that supports OSC 4 (most do). Persisting writes
# ~/.config/qol/theme.sh, which the zshrc sources on startup.
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
themes_dir="$repo_dir/themes"
state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/qol"
state_file="$state_dir/theme.sh"

current() {
  if [ -r "$state_file" ]; then
    sed -n 's/^# theme: \([a-z]*\).*/\1/p' "$state_file"
  fi
}

if [ $# -eq 0 ]; then
  cur="$(current)"
  echo "Available themes (theme <name> to switch):"
  for f in "$themes_dir"/*.sh; do
    name="$(basename "$f" .sh)"
    marker=" "
    [ "$name" = "$cur" ] && marker="*"
    desc="$(sed -n '1s/^# *//p' "$f")"
    printf ' %s %-8s %s\n' "$marker" "$name" "$desc"
  done
  exit 0
fi

name="$1"
theme_file="$themes_dir/$name.sh"
if [ ! -r "$theme_file" ]; then
  echo "theme: no such theme '$name' (run 'theme' to list)" >&2
  exit 1
fi

# shellcheck source=/dev/null
. "$theme_file"
read -ra colors <<< "$QOL_PALETTE"

apply() {
  local i
  for i in "${!colors[@]}"; do
    printf '\033]4;%d;#%s\a' "$i" "${colors[$i]}"
  done
  printf '\033]11;#%s\a' "${colors[0]}"    # background
  printf '\033]10;#%s\a' "${colors[15]}"   # foreground
}

mkdir -p "$state_dir"
{
  echo "# theme: $QOL_THEME_NAME (generated by 'theme' — do not edit)"
  echo "export QOL_ACCENT=$QOL_ACCENT"
  echo "QOL_PALETTE=\"$QOL_PALETTE\""
  # Re-apply on every new shell so tabs/splits match, tty only.
  cat <<'APPLY'
if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ "${TERM:-}" != linux ]; then
  _qol_i=0
  for _qol_hex in $QOL_PALETTE; do
    printf '\033]4;%d;#%s\a' "$_qol_i" "$_qol_hex"
    _qol_i=$(( _qol_i + 1 ))
  done
  unset _qol_i _qol_hex
fi
APPLY
} > "$state_file"

if [ -t 1 ]; then
  apply
fi
echo "theme: $QOL_THEME_NAME applied and saved"
